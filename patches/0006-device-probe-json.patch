+/// Local experiment hook: pin the graphics API instead of letting `Auto` settle on one.
+///
+/// `MONTGOMERY_WGPU_BACKEND=dx12|vulkan|gl` pins that API; anything else keeps Burn's default
+/// (`Auto`, which prefers Vulkan on Windows). This exists because cubecl picks device-side
+/// timestamp queries from the adapter's *advertised* `TIMESTAMP_QUERY` support, and a driver that
+/// advertises it without being able to map the readback poisons the device mid-run.
+#[cfg(feature = "gpu")]
+fn wgpu_device_from_env() -> burn::tensor::Device {
+    use burn::tensor::{Device, DeviceKind};
+    use burn_wgpu::{WgpuBackend, WgpuDevice};
+
+    let pinned = std::env::var("MONTGOMERY_WGPU_BACKEND").unwrap_or_default();
+    match pinned.trim().to_ascii_lowercase().as_str() {
+        "dx12" => Device::new(WgpuDevice::default().on(WgpuBackend::Dx12)),
+        "vulkan" => Device::new(WgpuDevice::default().on(WgpuBackend::Vulkan)),
+        "gl" => Device::new(WgpuDevice::default().on(WgpuBackend::Gl)),
+        // Diagnostics only: lets the trainer run its data -> forward -> loss -> backward path
+        // on the CPU when the machine's GPU cannot hold a device.
+        "cpu" => Device::flex(),
+        _ => Device::wgpu(DeviceKind::DefaultDevice),
+    }
+}
