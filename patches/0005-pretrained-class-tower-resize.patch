+//! Machine-readable training progress.
+//!
+//! `stdout` carries one JSON object per line so a GUI can stream progress without scraping prose.
+//! `stderr` keeps the human-readable narration. Both are written from the same numbers, so they
+//! cannot disagree — and no field exists only in the prose.
+//!
+//! A consumer should treat unknown `type` values as ignorable and unknown fields as additive: this
+//! is a contract for a GUI we ship, not a stable public API.
+
+use serde::Serialize;
+use std::io::Write;
+
+/// One progress event, tagged by `type` so consumers dispatch on a single field.
+#[derive(Debug, Clone, Serialize)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum TrainEvent {
+    /// Emitted once, after the dataset resolves and before the first batch.
+    Start {
+        /// Directory holding every artifact of this run.
+        run: String,
+        /// `"cpu"` or `"gpu"` — what the run actually executes on, not what was requested.
+        backend: String,
+        /// Adapter description as the runtime reports it.
+        adapter: String,
+        epochs: usize,
+        batch_size: usize,
+        image_size: Option<usize>,
+        class_names: Vec<String>,
+    },
+    /// Emitted after each epoch's training pass completes.
+    Epoch {
+        epoch: usize,
+        epochs: usize,
+        loss: f64,
+        /// Validation fitness when validation ran this epoch, otherwise absent.
+        fitness: Option<f64>,
+        /// Wall-clock seconds for this epoch.
+        elapsed_s: f64,
+    },
+    /// Emitted once, after checkpoints and exports are on disk.
+    End {
+        run: String,
+        best: Option<String>,
+        last: Option<String>,
+    },
+    /// Emitted instead of `End` when the run fails.
+    Error {
+        /// Stable machine identifier; see docs/API.md for the table.
+        code: String,
+        message: String,
+        /// What the user can actually do about it, when we know.
+        hint: Option<String>,
+    },
+}
+
+/// Write one event to `stdout` as a single line and flush immediately.
+///
+/// Flushing matters: a GUI that reads line-by-line must see progress while the run is happening, not
+/// when the process exits and the buffer drains.
+pub fn emit(event: &TrainEvent) {
+    let Ok(line) = serde_json::to_string(event) else {
+        return;
+    };
+    let mut stdout = std::io::stdout();
+    if writeln!(stdout, "{line}").is_ok() {
+        let _ = stdout.flush();
+    }
+}
+
+/// The backend this process was configured to train on.
+///
+/// Read from the environment because that is how the CLI hands the resolved choice to
+/// `default_wgpu_device()`; `"auto"` here means the caller never resolved one.
+pub fn configured_backend() -> String {
+    std::env::var("MONTGOMERY_WGPU_BACKEND").unwrap_or_else(|_| "auto".to_owned())
+}
