+/// Whether `path` names one of the two convolutions that make up a `Detect` classification tower.
+///
+/// The tower width is `max(ch[0], min(nc, 100))`. Only the `n` rung has `ch[0] <= 100` (64), so
+/// only there does the width follow the class count: an 80-class checkpoint has an 80-wide tower,
+/// a 3-class model a 64-wide one. The two 3x3 convolutions therefore cannot be copied across that
+/// boundary, and Ultralytics drops the mismatched keys in exactly the same place
+/// (`intersect_dicts`). The projection that follows them (`cls_out`) is already excluded by the
+/// projection filter; this function only has to cover the tower body.
+///
+/// Matched by module segment rather than by substring so that YOLOX's `head.cls_preds.N` — whose
+/// per-scale index is a bare number — is not swept in by accident.
+fn is_class_tower(path: &str) -> bool {
+    const TOWER: [&str; 6] = ["cls_0", "cls_1", "cls_dw_0", "cls_pw_0", "cls_dw_1", "cls_pw_1"];
+    path.split('.').any(|segment| TOWER.contains(&segment))
+}
