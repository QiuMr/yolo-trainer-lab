+    let (device, adapter) = match args.device {
+        DeviceProbeTarget::Cpu => (Device::flex(), "cpu".to_owned()),
+        DeviceProbeTarget::Gpu => montgomery::default_wgpu_device(),
+    };
+
+    let ones = Tensor::<2>::zeros([32, 32], &device) + 1.0;
+    let product = ones.clone().matmul(ones);
+    let total: f32 = product.sum().into_scalar::<f32>().elem();
+
+    const EXPECTED: f32 = 32.0 * 32.0 * 32.0;
+    if !total.is_finite() || (total - EXPECTED).abs() > 1e-3 {
+        return Err(format!(
+            "device probe produced {total}, expected {EXPECTED} ({adapter})"
+        )
+        .into());
+    }
+    eprintln!("Device probe: {adapter} ok (sum {total})");
+    Ok(())
+}
