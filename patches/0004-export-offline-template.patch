+/// Run the device probe as a child process and report whether it exited cleanly in time.
+#[cfg(feature = "training")]
+fn probe_backend(target: DeviceProbeTarget) -> bool {
+    let Ok(exe) = std::env::current_exe() else {
+        return false;
+    };
+    let label = match target {
+        DeviceProbeTarget::Gpu => "gpu",
+        DeviceProbeTarget::Cpu => "cpu",
+    };
+    let spawned = ProcessCommand::new(exe)
+        .arg("__device-probe")
+        .arg("--device")
+        .arg(label)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn();
+    let Ok(mut child) = spawned else {
+        return false;
+    };
+
+    let deadline = Instant::now() + DEVICE_PROBE_TIMEOUT;
+    loop {
+        match child.try_wait() {
+            Ok(Some(status)) => return status.success(),
+            Ok(None) if Instant::now() >= deadline => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return false;
+            }
+            Ok(None) => std::thread::sleep(std::time::Duration::from_millis(50)),
+            Err(_) => return false,
+        }
+    }
+}
