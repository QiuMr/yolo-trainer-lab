+/// Exercise one real kernel on the requested backend, reading the result back to the host.
+///
+/// The arithmetic is trivial and exact (32×32 of ones, multiplied, summed), so a failure here is a
+/// driver failure rather than a numerical one — and the readback is the step that catches the
+/// drivers that accept work but cannot return it.
+#[cfg(feature = "training")]
+fn run_device_probe(args: DeviceProbeArgs) -> montgomery::Result<()> {
+    use burn::tensor::{ElementConversion, Tensor};
