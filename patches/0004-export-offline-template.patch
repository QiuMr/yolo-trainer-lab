 #[allow(clippy::too_many_arguments)]
+fn export_from_template(
+    weights: &Path,
+    options: &OnnxExportOptions,
+    spec: ExportSpec,
+    directory: &Path,
+) -> Result<OnnxArtifact> {
+    let output = absolute_path(&options.output)?;
+    let sidecar = sidecar_path(&output);
+    refuse_or_validate_targets(&output, &sidecar, &external_data_path(&output), options.force)?;
+
+    let checkpoint = weights.to_owned();
+    let target = output.clone();
+    let skeletons = directory.to_owned();
+    let classes = spec.num_classes;
+    let report = std::thread::Builder::new()
+        .name("montgomery-onnx-fill".into())
+        .stack_size(128 * 1024 * 1024)
+        .spawn(move || -> Result<template::RenderReport> {
+            let predictor =
+                crate::Predictor::from_checkpoint(spec.model_id, checkpoint, PredictOptions::default())
+                    .map_err(|error| format!("checkpoint loading failed: {error}"))?;
+            template::render(&predictor, spec, &skeletons, classes, &target)
+        })?
+        .join()
+        .map_err(|_| -> Box<dyn std::error::Error + Send + Sync> {
+            "ONNX fill worker panicked".into()
+        })??;
+
+    let bytes = fs::metadata(&output)?.len();
+    let sha256 = sha256_file(&output)?;
+    let record = serde_json::json!({
+        "schema": "montgomery-onnx-offline-export-v1",
+        "model_id": report.model_id,
+        "model": output.display().to_string(),
+        "classes": report.classes,
+        "tensors": report.tensors_written,
+        "bytes": bytes,
+        "sha256": sha256,
+        "note": "Graph taken from the bundled skeleton; weights written from the checkpoint. \
+                 No Python or Ultralytics source was used.",
+    });
+    fs::write(&sidecar, serde_json::to_string_pretty(&record)?)?;
+
+    Ok(OnnxArtifact {
+        path: output,
+        sidecar,
+        external_data: None,
+        sha256,
+        bytes,
+    })
+}
