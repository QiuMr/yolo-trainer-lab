diff --git a/src/models/yolo11/head.rs b/src/models/yolo11/head.rs
index 4dc7658..d4c5a3c 100644
--- a/src/models/yolo11/head.rs
+++ b/src/models/yolo11/head.rs
@@ -204,6 +204,12 @@ impl Yolo11HeadConfig {
     pub fn with_num_classes(mut self, num_classes: usize) -> Self {
         assert!(num_classes > 0, "class count must be positive");
         self.num_classes = num_classes;
+        // `Detect` sizes the classification tower from the real class count — `max(ch[0], min(nc, 100))`
+        // — but `new` cannot know nc yet, so it falls back to the COCO default. Leaving the tower at
+        // that default while nc is 3 makes it 80 wide instead of 64: harmless during training (the
+        // extra channels go unused) and only visible when an exported graph is audited against the
+        // Ultralytics reconstruction, where it shows up as every cv3 tensor having the wrong shape.
+        self.cls_channels = self.p3_channels.max(num_classes.min(100));
         self
     }
 
