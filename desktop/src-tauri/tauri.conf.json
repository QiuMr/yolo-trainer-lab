{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YOLO Trainer",
  "version": "0.1.3",
  "identifier": "com.yolotrainer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YOLO Trainer",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0ODUxNUI2NTIyMDE0ODgKUldTSUZDQlN0aFdGUkF4YmovQVora0VJaTQ3RkdOZkQxaDhhaUhzT0l2Z2xRTmhGN1RwL1M2dXcK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/QiuMr/yolo-trainer-lab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/montgomery"],
    "resources": ["resources/onnx/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
